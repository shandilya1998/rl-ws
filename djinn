#!/bin/bash

spawn_container_if_needed() {
    name=$1
    image_name=$2
    platform=$3
    gpus=$4
    echo "Starting container of name: $name from image $image_name"

    if [[ -n "$(docker ps -a -q -f name="${name}")" ]]; then
        if [[ -n "$(docker ps -aq -f status=exited -f name="${name}")" ]]; then
            # restart stopped container
            echo "Container Exists but stopped, restarting"
            docker start "${name}"
        else
            echo "Container exists and already present"
        fi
    else
        echo "Container does not exist creating now"
        if [[ ! -n "$platform" ]]; then
            platform="$(uname -p)"
        fi
        source $PROJECT_WS/docker/scripts/start.sh $PROJECT_WS "${name}" ${image_name} ${platform} ${gpus}
    fi
}

iexec() {
    time docker container exec -it "$1" /bin/bash -l -c "$2"
}

if [[ -n $1 ]]; then
    if [[ "$1" == "up" ]]; then
        if [[ "$2" == "dev" ]]; then
            spawn_container_if_needed dev_container shandilya1998/nrt:dev "linux/amd64" "no_gpus"
        elif [[ "$2" == "lab" ]]; then
            gpu_id="${3:-0}"
            suffix="$USER-gpu$gpu_id"
            suffixed_image="isaac-lab-base-$suffix:latest"
            base_image="isaac-lab-base:latest"
            if ! docker image inspect "$suffixed_image" >/dev/null 2>&1; then
                if ! docker image inspect "$base_image" >/dev/null 2>&1; then
                    $PROJECT_WS/IsaacLab/docker/container.py build base
                fi
                docker tag "$base_image" "$suffixed_image"
            fi
            $PROJECT_WS/IsaacLab/docker/container.py start-no-build base --suffix "$suffix" --gpu-id "$gpu_id"
        fi
    elif [[ "$1" == "exec" ]]; then
        container_name="dev_container"
        if [[ -n "$2" ]]; then
            if [[ "$2" =~ ^lab([0-9]+)?$ ]]; then
                gpu_id="${BASH_REMATCH[1]:-0}"
                container_name="isaac-lab-base-$USER-gpu$gpu_id"
            else
                container_name="$2_container"
            fi
        fi
        if [[ -n "$3" ]]; then
            echo "Running command in $container_name: $3"
            iexec "$container_name" "$3"
        else
            echo "Entering container: $container_name"
            docker container exec -it "$container_name" /bin/bash -l
        fi
    elif [[ "$1" == "build" ]]; then
        if [[ "$2" == "docker" ]]; then
            if [[ -n "$3" ]]; then
                if [[ "$3" == "isaaclab" ]]; then
                    sudo chown $USER:$USER $PROJECT_WS/IsaacLab/docker/
                    $PROJECT_WS/IsaacLab/docker/container.sh start
                fi
            fi
        fi
    elif [[ "$1" == "down" ]]; then
        container_name="dev_container"
        if [[ "$2" == "dev" ]]; then
            container_name="dev_container"
        elif [[ "$2" =~ ^lab([0-9]+)?$ ]]; then
            gpu_id="${BASH_REMATCH[1]:-0}"
            container_name="isaac-lab-base-$USER-gpu$gpu_id"
        fi
        docker stop $container_name && docker rm $container_name
    elif [[ "$1" == "ps" ]]; then
        if [[ -n "$2" ]]; then
            if [[ "$2" == "-a" ]]; then
                docker ps -a
            else
                echo "Invalid option for djinn ps"
            fi
        else
            docker ps
        fi
    elif [[ "$1" == "start" ]]; then
        if [[ "$2" == "train" ]]; then
            if [[ ! -n "$3" ]]; then
                echo "no training mode provided exiting"
                exit 1
            else
                # only one GPU is visible inside a per-GPU container, so the
                # in-container torch device is always cuda:0; the numeric arg
                # selects which GPU container to run in.
                device="cuda:0"
                seed=42
                checkpoint_path=""
                gpu_id="${4:-0}"
                container="isaac-lab-base-$USER-gpu$gpu_id"
                if [[ -n "$5" ]]; then
                    run_path="logs/rsl_rl/$5"
                    if [[ -n "$6" ]]; then
                        checkpoint_path="$run_path/$6"
                    else
                        echo "check point path must be provided with run directory to continue the same experiment"
                    fi
                fi

                task="Isaac-Limx-SF-Identified-Blind-Flat-v0"
                policy_type="PPO"
                if [[ "$3" == "base" ]]; then
                    echo "Starting base env training with seed $seed for task $task"
                elif [[ "$3" == "base-urdf" ]]; then
                    task="Isaac-Limx-SF-Identified-Blind-Rough-Urdf-v0"
                    echo "Starting base env training with seed $seed for task $task"
                elif [[ "$3" == "berkeley" ]]; then
                    task="Isaac-Limx-SF-Identified-Berkeley-v0"
                elif [[ "$3" == "him" ]]; then
                    task="Isaac-Limx-SF-HIM-Identified-Blind-Rough-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "him-urdf" ]]; then
                    task="Isaac-Limx-SF-HIM-Identified-Blind-Rough-Urdf-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "copt" ]]; then
                    task="Isaac-Limx-SF-Copt-MoRAL-Rough-v0"
                    policy_type="COPT"
                elif [[ "$3" == "brs" ]]; then
                    task="Isaac-Limx-SDBRS1-Blind-Flat-v0"
                elif [[ "$3" == "brs-simplified" ]]; then
                    task="Isaac-Limx-SDBRS1-Blind-Flat2-v0"
                elif [[ "$3" == "quadruped" ]]; then
                    task="Isaac-Quadruped-Blind-Rough-v0"
                elif [[ "$3" == "quadruped-flat" ]]; then
                    task="Isaac-Quadruped-Blind-Flat-v0"
                elif [[ "$3" == "quadruped-him" ]]; then
                    task="Isaac-Quadruped-HIM-Blind-Rough-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "quadruped-copt" ]]; then
                    task="Isaac-Quadruped-Copt-Rough-v0"
                    policy_type="COPT"
                elif [[ "$3" == "quadruped-debug" ]]; then
                    # Timing-instrumented DebugOnPolicyRunner over the quadruped's own
                    # task, unchanged. See context/go1_quadruped_throughput.md.
                    task="Isaac-Quadruped-Blind-Rough-v0"
                    policy_type="quadruped-debug"
                elif [[ "$3" == "go1-debug" ]]; then
                    # Same runner and the quadruped's own environment and MDP stack, but
                    # the Unitree Go1 USD in place of the quadruped's asset, to isolate
                    # whether the throughput gap traces to the asset or to the
                    # environment configuration. See QuadrupedPFGo1AssetBaseEnvCfg's
                    # docstring and context/go1_quadruped_throughput.md.
                    task="Isaac-Quadruped-Go1Asset-Blind-Rough-v0"
                    policy_type="go1-debug"
                elif [[ "$3" == "go1-default-debug" ]]; then
                    # IsaacLab's own shipped Go1 rough task, unchanged except for
                    # num_envs and the terrain generator, both matched to the quadruped
                    # task and to go1-debug above, so population and terrain stop being
                    # confounds against either. See Go1NativeMatchedEnvCfg's docstring
                    # and context/go1_quadruped_throughput.md. Byte identical PPO
                    # hyperparameters to Isaac-Velocity-Rough-Unitree-Go1-v0.
                    task="Isaac-Quadruped-Go1Native-Matched-Rough-v0"
                    policy_type="go1-default-debug"
                elif [[ "$3" == "kscale" ]]; then
                    task="Isaac-Limx-Kscale-Blind-Flat-v0"
                elif [[ "$3" == "kscale-rough" ]]; then
                    task="Isaac-Limx-Kscale-Blind-Rough-v0"
                elif [[ "$3" == "kscale-him" ]]; then
                    task="Isaac-Limx-Kscale-HIM-Blind-Flat-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "kscale-him-rough" ]]; then
                    task="Isaac-Limx-Kscale-HIM-Blind-Rough-v0"
                    policy_type="HIMPPO"
                # ARM 14 of biped/plans/kscale_gait_shaping.md section 21.14, the hip yaw
                # frozen in the URDF.  Ten joints against the twelve of "kscale", and the
                # same PPO runner, so the two differ in the environment alone.
                elif [[ "$3" == "kscale-hip-yaw-fixed" ]]; then
                    task="Isaac-Limx-Kscale-HipYawFixed-Blind-Flat-v0"
                else
                    # Fail loudly. Both dispatch chains assign a default before testing any
                    # clause, so before this arm existed an unrecognised mode did not fail, it
                    # silently selected the TRON1 SoleFoot. A user asking for a robot with no
                    # clause received a complete, plausible, converging run of a DIFFERENT
                    # robot, the wrong task id appearing only in that run's dumped params/env.yaml
                    # where nobody looks until something is already wrong. "base" is spelled out
                    # rather than folded into this arm so that the default stays explicit.
                    echo "unknown training mode '$3'"
                    echo "expected one of: base base-urdf berkeley him him-urdf copt"
                    echo "                 brs brs-simplified quadruped"
                    echo "                 quadruped-flat quadruped-him quadruped-copt"
                    echo "                 quadruped-debug go1-debug go1-default-debug"
                    echo "                 kscale kscale-rough kscale-him kscale-him-rough"
                    echo "                 kscale-hip-yaw-fixed"
                    exit 1
                fi
                iexec "$container" "./isaaclab.sh -p -m pip install -e biped/environments biped/co_optimisation/ biped/himloco biped/rsl_rl biped/design_generator"
                if [[ -n "$checkpoint_path" ]]; then
                    echo "checkpoint path: $checkpoint_path"
                    iexec "$container" "./isaaclab.sh -p biped/scripts/rsl_rl/train.py --task $task --video --video_length 2000 --video_interval 10000 --save_interval 1000 --seed 42 --headless --device $device --policy-type $policy_type --checkpoint_path $checkpoint_path --resume true --load_run $run_path"
                else
                    iexec "$container" "./isaaclab.sh -p biped/scripts/rsl_rl/train.py --task $task --video --video_length 2000 --video_interval 10000 --save_interval 1000 --seed 42 --headless --device $device --policy-type $policy_type"
                fi
            fi
        elif [[ "$2" == "play" ]]; then
            if [[ ! -n "$3" ]]; then
                echo "no mode provided exiting"
                exit 1
            else
                checkpoint_path="/workspace/isaaclab/logs/rsl_rl/$4"
                seed="$5"
                # one GPU per container → in-container device is always cuda:0;
                # the numeric arg ($6) selects which GPU container to run in.
                device="cuda:0"
                gpu_id="${6:-0}"
                container="isaac-lab-base-$USER-gpu$gpu_id"
                task="Isaac-Limx-SF-Identified-Blind-Rough-Play-v0"
                policy_type="PPO"
                if [[ "$3" == "base" ]]; then
                    echo "Starting base env evaluation with seed $seed"
                elif [[ "$3" == "base-urdf" ]]; then
                    task="Isaac-Limx-SF-Identified-Blind-Rough-Play-Urdf-v0"
                    echo "Starting base env evaluation with seed $seed"
                elif [[ "$3" == "berkeley" ]]; then
                    task="Isaac-Limx-SF-Identified-Berkeley-Play-v0"
                elif [[ "$3" == "him" ]]; then
                    task="Isaac-Limx-SF-HIM-Identified-Blind-Rough-v0"
                elif [[ "$3" == "copt" ]]; then
                    task="Isaac-Limx-SF-Copt-MoRAL-Rough-Play-v0"
                    policy_type="COPT"
                elif [[ "$3" == "brs" ]]; then
                    task="Isaac-Limx-SDBRS1-Blind-Flat-Play-v0"
                elif [[ "$3" == "brs-simplified" ]]; then
                    task="Isaac-Limx-SDBRS1-Blind-Flat2-Play-v0"
                elif [[ "$3" == "quadruped" ]]; then
                    task="Isaac-Quadruped-Blind-Rough-Play-v0"
                elif [[ "$3" == "quadruped-flat" ]]; then
                    task="Isaac-Quadruped-Blind-Flat-Play-v0"
                elif [[ "$3" == "quadruped-him" ]]; then
                    task="Isaac-Quadruped-HIM-Blind-Rough-Play-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "quadruped-copt" ]]; then
                    task="Isaac-Quadruped-Copt-Rough-Play-v0"
                    policy_type="COPT"
                elif [[ "$3" == "kscale" ]]; then
                    task="Isaac-Limx-Kscale-Blind-Flat-Play-v0"
                elif [[ "$3" == "kscale-rough" ]]; then
                    task="Isaac-Limx-Kscale-Blind-Rough-Play-v0"
                elif [[ "$3" == "kscale-him" ]]; then
                    task="Isaac-Limx-Kscale-HIM-Blind-Flat-Play-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "kscale-him-rough" ]]; then
                    task="Isaac-Limx-Kscale-HIM-Blind-Rough-Play-v0"
                    policy_type="HIMPPO"
                elif [[ "$3" == "kscale-hip-yaw-fixed" ]]; then
                    task="Isaac-Limx-Kscale-HipYawFixed-Blind-Flat-Play-v0"
                else
                    # See the note on the corresponding arm of the training chain above.
                    echo "unknown play mode '$3'"
                    echo "expected one of: base base-urdf berkeley him copt brs"
                    echo "                 brs-simplified quadruped quadruped-flat quadruped-him"
                    echo "                 quadruped-copt kscale kscale-rough kscale-him"
                    echo "                 kscale-him-rough kscale-hip-yaw-fixed"
                    exit 1
                fi
                iexec "$container" "./isaaclab.sh -p -m pip install -e biped/environments biped/co_optimisation/ biped/himloco biped/design_generator"
                iexec "$container" "./isaaclab.sh -p biped/scripts/rsl_rl/play.py --task $task --video --video_length 3000 --seed $seed --checkpoint_path $checkpoint_path --enable_cameras --headless --device $device --policy-type $policy_type --num_envs 32"
            fi
        elif [[ "$2" == "evaluation" ]]; then
            task="Isaac-Limx-SF-Blind-Flat-v0"
            seed="$3"
            if [[ ! -n "$3" ]]; then
                seed=42
            fi
            # one GPU per container → in-container device is always cuda:0;
            # the numeric arg ($4) selects which GPU container to run in.
            device="cuda:0"
            gpu_id="${4:-0}"
            container="isaac-lab-base-$USER-gpu$gpu_id"
            test_dir="/workspace/isaaclab/logs/rsl_rl/test"
            echo "Starting Evaluation with seed $seed"
            iexec "$container" "./isaaclab.sh -p -m pip install -e biped/environments && \
                find \"$test_dir\" -mindepth 1 -maxdepth 1 -type d -print0 | while IFS= read -r -d '' d; do
                    echo \"Evaluating policy for experiment at \$d\" 
                    ./isaaclab.sh -p biped/scripts/rsl_rl/play.py --task $task --video --video_length 2500 --num_envs 1 --seed $seed --checkpoint_path \$d/model_14999.pt --enable_cameras --headless --device $device
                done"
        elif [[ "$2" == "visualise-evaluation" ]]; then
            gpu_id="${3:-0}"
            container="isaac-lab-base-$USER-gpu$gpu_id"
            iexec "$container" "./isaaclab.sh -p /workspace/isaaclab/biped/scripts/rsl_rl/visualise.py --evaluation --experiment_dir /workspace/isaaclab/logs/rsl_rl --log_dir /workspace/isaaclabs/outputs"
        fi
    fi
fi
